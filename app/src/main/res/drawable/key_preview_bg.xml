<?xml version="1.0" encoding="utf-8"?>
<!-- Gboard-style key preview bubble: dark, rounded, with a subtle bottom pointer shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow/depth layer -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#33000000"/>
        </shape>
    </item>
    <!-- Main bubble -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#4F565C"/>
            <stroke android:width="1dp" android:color="#5A6470"/>
            <padding android:left="10dp" android:top="6dp"
                android:right="10dp" android:bottom="6dp"/>
        </shape>
    </item>
</layer-list>