<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Fix #3: Android 11+ (API 30+) package visibility.
        Without this, SpeechRecognizer.isRecognitionAvailable() always returns
        false on Android 11+ because background apps can't see system services
        unless explicitly declared here.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for custom keyboard background image picker (Android ≤ 12) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Required for custom keyboard background image picker (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />



    <!-- No special permissions needed for a basic IME -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!--
            The InputMethod service declaration.
            - BIND_INPUT_METHOD permission ensures only the system can bind to this service.
            - The meta-data tag points to method.xml which defines IME subtypes.
        -->
        <service
            android:name=".core.MyKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
            PickImageActivity — transparent companion Activity used by the keyboard
            to open the system image picker and receive the result URI.
            InputMethodService cannot use startActivityForResult(), so this thin
            Activity bridges that gap. The transparent theme keeps UX clean.
        -->
        <activity
            android:name=".theme.PickImageActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!--
            KeyboardSettingsActivity — full-screen settings screen.
            Launched from the keyboard's ⚙ toolbar button via:
                Intent intent = new Intent(this, KeyboardSettingsActivity.class);
                intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                startActivity(intent);
        -->
        <activity
            android:name=".settings.KeyboardSettingsActivity"
            android:exported="true"
            android:label="Keyboard Settings"
            android:theme="@style/Theme.MyApplication"/>

        <activity
            android:name=".settings.SettingsCorrectionsActivity"
            android:exported="false"
            android:label="Corrections and suggestions"
            android:theme="@style/Theme.MyApplication"/>

        <activity
            android:name=".theme.SettingsThemeActivity"
            android:exported="false"
            android:label="Theme"
            android:theme="@style/Theme.MyApplication"/>

    </application>

</manifest>