<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings panel — themes, sounds, toggles, custom photo.
    Shown/hidden by the ⚙️ button in the toolbar.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_panel"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="#1B2127"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- ── Theme Section ────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎨 Theme"
                android:textStyle="bold"
                android:textColor="#B8BEC7"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/theme_preview_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default"
                android:textColor="#888888"
                android:textSize="10sp"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/theme_light"
                    android:layout_width="70dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:text="☀️ Light"
                    android:textSize="10sp"
                    android:backgroundTint="#E0E0E0"/>

                <Button
                    android:id="@+id/theme_dark"
                    android:layout_width="70dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:text="🌙 Dark"
                    android:textSize="10sp"
                    android:backgroundTint="#3D4043"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/theme_black"
                    android:layout_width="70dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:text="⬛ Black"
                    android:textSize="10sp"
                    android:backgroundTint="#111111"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/theme_amoled"
                    android:layout_width="80dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:text="🖤 AMOLED"
                    android:textSize="10sp"
                    android:backgroundTint="#000000"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/theme_blue"
                    android:layout_width="70dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:text="🔵 Blue"
                    android:textSize="10sp"
                    android:backgroundTint="#1565C0"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/theme_green"
                    android:layout_width="70dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:text="🟢 Green"
                    android:textSize="10sp"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/theme_custom_image"
                    android:layout_width="90dp"
                    android:layout_height="34dp"
                    android:text="🖼️ Custom"
                    android:textSize="10sp"
                    android:backgroundTint="#546E7A"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ── Sound Section ────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 Key Sounds"
            android:textStyle="bold"
            android:textColor="#B8BEC7"
            android:textSize="12sp"
            android:paddingBottom="5dp"/>

        <!-- Row 1: Off · Mechanical · Typewriter · Bubble -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="3dp">

            <Button
                android:id="@+id/sound_off"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="🔇 Off"
                android:textSize="9sp"
                android:backgroundTint="#444950"/>

            <Button
                android:id="@+id/sound_mechanical"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="⚙️ Mech"
                android:textSize="9sp"
                android:backgroundTint="#607D8B"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/sound_typewriter"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="📜 Type"
                android:textSize="9sp"
                android:backgroundTint="#795548"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/sound_bubble"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="🫧 Bubble"
                android:textSize="9sp"
                android:backgroundTint="#00838F"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Row 2: Gaming · Soft · Crystal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/sound_gaming"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="🎮 Gaming"
                android:textSize="9sp"
                android:backgroundTint="#6A1B9A"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/sound_soft"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="🌿 Soft"
                android:textSize="9sp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/sound_crystal"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="🔮 Crystal"
                android:textSize="9sp"
                android:backgroundTint="#4527A0"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Volume slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔉"
                android:textSize="14sp"
                android:paddingEnd="6dp"/>

            <SeekBar
                android:id="@+id/volume_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="70"/>

        </LinearLayout>

        <!-- ── Custom Photo Background ───────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️ Custom Photo Background"
            android:textStyle="bold"
            android:textColor="#B8BEC7"
            android:textSize="12sp"
            android:paddingBottom="5dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <!-- Toggle Enable ON/OFF -->
            <Button
                android:id="@+id/btn_enable_custom_bg"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🖼️ Custom BG: OFF"
                android:textSize="10sp"
                android:backgroundTint="#37474F"
                android:textColor="#FFFFFF"/>

            <!-- Open gallery to pick an image -->
            <Button
                android:id="@+id/btn_pick_photo"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="📷 Pick Photo"
                android:textSize="10sp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- ── Options ──────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Options"
            android:textStyle="bold"
            android:textColor="#B8BEC7"
            android:textSize="12sp"
            android:paddingBottom="5dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/toggle_number_row"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="🔢 Numbers"
                android:textSize="9sp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/toggle_swipe_typing"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="👆 Swipe"
                android:textSize="9sp"
                android:backgroundTint="#E65100"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/toggle_ai_replies"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="🤖 AI Replies"
                android:textSize="9sp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- ── Toolbar Customization ────────────────────────────────────────── -->
        <Button
            android:id="@+id/btn_customize_toolbar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="🛠️ Customize Toolbar"
            android:textSize="10sp"
            android:backgroundTint="#455A64"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</ScrollView>