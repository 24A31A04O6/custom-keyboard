<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_pressed="true">
                <inset android:insetLeft="3dp" android:insetTop="3dp"
                       android:insetRight="3dp" android:insetBottom="3dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="12dp"/>
                        <solid android:color="#40444A"/>
                    </shape>
                </inset>
            </item>
            <item>
                <inset android:insetLeft="3dp" android:insetTop="3dp"
                       android:insetRight="3dp" android:insetBottom="3dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="12dp"/>
                        <solid android:color="#22242B"/>
                    </shape>
                </inset>
            </item>
        </selector>
    </item>
</layer-list>
