    </LinearLayout>

    <!-- â•â• RESIZE OVERLAY â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         Sits on top of everything in the outer FrameLayout.
         Shown when resize mode is active (GONE by default).
         Structure matches the Gboard resize UX:
           â€¢ Top drag-handle strip â†’ user slides finger up/down to set height
           â€¢ Dim scrim covers the keyboard
           â€¢ Reset + âœšmove-icon + Done row in the centre
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <FrameLayout
        android:id="@+id/resize_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Dim background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000"/>

        <!-- Drag handle at the very top â€” user grabs and slides vertically -->
        <LinearLayout
            android:id="@+id/resize_drag_handle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#00000000">

            <!-- Visible pill handle indicator -->
            <View
                android:layout_width="56dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:background="#AAAAAA"
                android:backgroundTintMode="src_in"/>
        </LinearLayout>

        <!-- Centre row: Reset  âœ›  Done -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Reset button -->
            <Button
                android:id="@+id/btn_resize_reset"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="â†º  Reset"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#1565C0"
                android:stateListAnimator="@null"
                android:layout_marginEnd="16dp"/>

            <!-- Move/drag icon â€” purely visual, same drag target as whole overlay -->
            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="âœ›"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/key_background_normal"
                android:layout_marginEnd="16dp"/>

            <!-- Done button -->
            <Button
                android:id="@+id/btn_resize_done"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="âœ“  Done"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#1565C0"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>

