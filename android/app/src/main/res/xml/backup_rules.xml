<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive EncryptedSharedPreferences and clipboard -->
    <exclude domain="sharedpref" path="babelkey_encrypted_prefs.xml"/>
    <exclude domain="sharedpref" path="babelkey_encrypted_prefs_fallback.xml"/>
    <exclude domain="sharedpref" path="MyBoardPrefs.xml"/>
    <exclude domain="file" path="clipboard/"/>
    <!-- Dictionary assets are Bundled — no need to back up -->
    <exclude domain="file" path="dictionaries/"/>
</full-backup-content>
