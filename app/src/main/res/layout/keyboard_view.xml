<?xml version="1.0" encoding="utf-8"?>
<!--
    keyboard_view.xml — Root layout returned by onCreateInputView().

    Structure:
    ┌─────────────────────────────────────────────────────────┐
    │  keyboard_root (LinearLayout, vertical)                 │
    │  ┌───────────────────────────────────────────────────┐  │
    │  │  toolbar_strip (7 fixed icons, always visible)    │  │
    │  ├───────────────────────────────────────────────────┤  │
    │  │  banners / voice panel / OTP / grammar (GONE)     │  │
    │  ├───────────────────────────────────────────────────┤  │
    │  │  suggestion_scroll                                │  │
    │  ├───────────────────────────────────────────────────┤  │
    │  │  content_flipper (ViewFlipper)                    │  │
    │  │  ┌─────────────────┐  child 0 = keyboard_view    │  │
    │  │  │  child 1 = emoji │  child 2 = gif placeholder  │  │
    │  │  │  child 3 = theme │  child 4 = settings panel   │  │
    │  │  └─────────────────┘                              │  │
    │  └───────────────────────────────────────────────────┘  │
    └─────────────────────────────────────────────────────────┘
    The trackpad overlay sits in the outer FrameLayout on top of everything.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="0dp">

    <!-- ══ MAIN KEYBOARD ROOT ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/keyboard_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="0dp"
        android:background="@color/toolbar_background">

        <!-- ── TOOLBAR STRIP ────────────────────────────────────────────────── -->
        <!--
            Gboard-style configurable toolbar strip. The visible buttons are
            injected at runtime into toolbar_strip_dynamic by
            MyKeyboardService.rebuildToolbar() from the saved
            toolbarButtonConfig (toolbar_button_config pref). The trailing
            "More" button (btn_customize_toolbar) opens the toolbar editor;
            long-pressing any toolbar button opens it as well.
        -->
        <LinearLayout
            android:id="@+id/toolbar_strip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@color/toolbar_background"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Gboard-style configurable toolbar: buttons are injected here at
                 runtime by MyKeyboardService.rebuildToolbar() according to the
                 user's saved toolbar config (toolbarButtonConfig). -->
            <LinearLayout
                android:id="@+id/toolbar_strip_dynamic"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="Toolbar"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>

            <!-- "More" button: opens the Gboard-style toolbar editor. -->
            <ImageView
                android:id="@+id/btn_customize_toolbar"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:contentDescription="Customize toolbar"
                android:src="@drawable/ic_tool_grid"
                android:scaleType="centerInside"
                android:tint="@color/toolbar_icon_inactive"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"/>
        </LinearLayout>
<!-- End toolbar_strip -->




        <!-- ── Legacy scrollable toolbar_row (kept for backward compat) ──────── -->
        <HorizontalScrollView
            android:id="@+id/toolbar_scroll_legacy"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:visibility="gone"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/toolbar_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <!-- ── OTP BANNER ───────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/otp_banner"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="#FFF3CD"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/otp_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OTP: 123456 — Tap to paste"
                android:textSize="13sp"
                android:textColor="#856404"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_otp_paste"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Paste"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF8C00"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

            <Button
                android:id="@+id/btn_otp_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="✖"
                android:textSize="11sp"
                android:textColor="#856404"
                android:background="@android:color/transparent"

                android:paddingStart="6dp"
                android:paddingEnd="6dp"/>

        </LinearLayout>

        <!-- ── VOICE TYPING PANEL ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/voice_typing_panel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/toolbar_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageView 
                android:contentDescription="Exit voice input" 
                android:id="@+id/btn_voice_back" 
                android:layout_height="32dp" 
                android:layout_width="32dp" 
                android:src="@drawable/arrow_back_24"
                android:background="?android:attr/selectableItemBackground"
                android:tint="#FFFFFF"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/voice_status_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Speak now"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>

            <ImageView 
                android:contentDescription="Minimize voice input" 
                android:id="@+id/btn_voice_collapse" 
                android:layout_height="32dp" 
                android:layout_width="32dp" 
                android:src="@drawable/keyboard_arrow_down_24"
                android:background="?android:attr/selectableItemBackground"
                android:tint="#FFFFFF"
                android:padding="4dp"
                android:layout_marginEnd="12dp"/>
                
            <ImageView
                android:id="@+id/btn_voice_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/ic_mic_bg_circle"
                android:tint="#FFFFFF"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- ── GRAMMAR BANNER ────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/grammar_banner"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="#E8F4FD"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/grammar_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Suggestion: ..."
                android:textSize="12sp"
                android:textColor="#0056A0"
                android:ellipsize="end"
                android:maxLines="1"/>

            <Button
                android:id="@+id/btn_grammar_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="✕"
                android:textSize="11sp"
                android:textColor="#0056A0"
                android:background="@android:color/transparent"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"/>

        </LinearLayout>

        <!-- ── SUGGESTION BAR ───────────────────────────────────────────────── -->
        <HorizontalScrollView
            android:id="@+id/suggestion_scroll"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:scrollbars="none"
            android:background="@color/toolbar_background"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/suggestion_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

        </HorizontalScrollView>

        <!--
             Child index constants (see MyKeyboardService.FLIPPER_*):
               0 = keyboard (KeyboardView)
               1 = emoji panel (FrameLayout host, populated at runtime)
               2 = settings quick-panel (legacy mini-panel; full settings
                   live in KeyboardSettingsActivity)
        -->
        <!-- LEGACY PANEL HOST
             Panels toggled by toolbar buttons (stats, phrases, AI replies,
             clipboard row, toolbar customizer). They sit ABOVE the keyboard
             flipper so setVisibility() actually shows them while typing.  -->
        <LinearLayout
            android:id="@+id/panels_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/toolbar_background">

<LinearLayout
                        android:id="@+id/toolbar_customizer_panel"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:orientation="vertical"
                        android:background="@color/settings_panel_background"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="#E0E0E0">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Customize Toolbar - check to show, &#9650;&#9660; to reorder"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"/>

                            <TextView
                                android:id="@+id/btn_tb_customizer_done"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&#10003; Done"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#1565C0"
                                android:background="?android:attr/selectableItemBackground"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"/>

                        </LinearLayout>

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:id="@+id/toolbar_customizer_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"/>

                        </ScrollView>

                    </LinearLayout>
<ScrollView
                        android:id="@+id/stats_panel"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@color/stats_panel_background"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/stats_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"/>

                    </ScrollView>
<LinearLayout
                        android:id="@+id/clipboard_panel"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:orientation="vertical"
                        android:background="@color/clipboard_panel_background"
                        android:visibility="gone">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/clipboard_container"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:padding="6dp"
                                android:gravity="center_vertical"/>

                        </HorizontalScrollView>

                    </LinearLayout>
<HorizontalScrollView
                        android:id="@+id/phrases_panel"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:scrollbars="none"
                        android:background="@color/phrases_panel_background"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/phrases_container"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"/>

                    </HorizontalScrollView>
<HorizontalScrollView
                        android:id="@+id/ai_replies_panel"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:scrollbars="none"
                        android:background="@color/ai_chip_background"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/ai_replies_container"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"/>

                    </HorizontalScrollView>
        </LinearLayout>

        <!-- ── CLIPBOARD DRAWER ─────────────────────────────────────────────────
             Hidden by default; toggled by the clipboard toolbar button.        -->
        <FrameLayout
            android:id="@+id/clipboard_drawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <include layout="@layout/layout_clipboard_drawer"/>
        </FrameLayout>

        <ViewFlipper
            android:id="@+id/content_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ── Child 0: KEYBOARD ────────────────────────────────────────── -->
            <com.babeltech.babelkey.core.BabelKeyboardView
                android:id="@+id/keyboard_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:keyTextSize="21sp"
                android:labelTextSize="15sp"
                android:keyTextColor="#E8EAED"
                android:keyBackground="@drawable/key_background_normal"
                android:shadowColor="#00000000"
                android:shadowRadius="0"
                android:background="@color/toolbar_background"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"/>

            <!-- ── Child 1: EMOJI HOST ────────────────────────────────────── -->
            <!--  Populated at runtime by EmojiKeyboardView  -->
            <FrameLayout
                android:id="@+id/emoji_flipper_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/toolbar_background"/>

            <!-- ── Child 2: THEME QUICK-PANEL ───────────────────────────────── -->
            <include layout="@layout/settings_panel"/>

            <!-- ── Child 3: SETTINGS / STATS / MISC PANELS ──────────────────── -->
            <!--
                Legacy panels that the service toggles with setVisibility() are
                kept here inside a ScrollView so they don't break old service code.
            -->
            </ViewFlipper>
        <!-- End content_flipper -->

    </LinearLayout>
    <!-- End keyboard_root -->

    <!-- ══ TRACKPAD OVERLAY (sits above everything in the FrameLayout) ══════ -->
    <LinearLayout
        android:id="@+id/trackpad_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/trackpad_bg"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👆 Trackpad Mode"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slide finger to move cursor"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:paddingBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Release to exit"
            android:textColor="#AAAAAA"
            android:textSize="11sp"/>

    </LinearLayout>

    <!-- ══ RESIZE OVERLAY ════════════════════════════════════════════════════════
         Sits on top of everything in the outer FrameLayout.
         Shown when resize mode is active (GONE by default).
         Structure matches the Gboard resize UX:
           • Top drag-handle strip → user slides finger up/down to set height
           • Dim scrim covers the keyboard
           • Reset + ✚move-icon + Done row in the centre
    ════════════════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/resize_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Dim background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000"/>

        <!-- Drag handle at the very top — user grabs and slides vertically -->
        <LinearLayout
            android:id="@+id/resize_drag_handle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#00000000">

            <!-- Visible pill handle indicator -->
            <View
                android:layout_width="56dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:background="#AAAAAA"
                android:backgroundTintMode="src_in"/>
        </LinearLayout>

        <!-- Centre row: Reset  ✛  Done -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Reset button -->
            <Button
                android:id="@+id/btn_resize_reset"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="↺  Reset"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#1565C0"
                android:stateListAnimator="@null"
                android:layout_marginEnd="16dp"/>

            <!-- Move/drag icon — purely visual, same drag target as whole overlay -->
            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="✛"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/key_background_normal"
                android:layout_marginEnd="16dp"/>

            <!-- Done button -->
            <Button
                android:id="@+id/btn_resize_done"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="✓  Done"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#1565C0"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>

