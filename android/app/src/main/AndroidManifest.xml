<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility for SpeechRecognizer (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Primary IME — thin service per layered architecture (service/ime) -->
        <service
            android:name=".service.ime.BabelImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <!-- Legacy IME alias — kept for users who already enabled the keyboard before Phase 1.
             Will be removed after one release once all installs have migrated to BabelImeService.
             Both services share the same method.xml subtypes. -->
        <service
            android:name=".core.MyKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <activity
            android:name=".theme.PickImageActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <activity
            android:name=".settings.KeyboardSettingsActivity"
            android:exported="true"
            android:label="Keyboard Settings"
            android:theme="@style/Theme.MyApplication"/>

        <activity
            android:name=".settings.SettingsCorrectionsActivity"
            android:exported="false"
            android:label="Corrections and suggestions"
            android:theme="@style/Theme.MyApplication"/>

        <activity
            android:name=".theme.SettingsThemeActivity"
            android:exported="false"
            android:label="Theme"
            android:theme="@style/Theme.MyApplication"/>

        <!-- OTP app hash display activity (Phase 2) — shows SmsRetrieverHelper hash for provider config -->
        <activity
            android:name=".core.otp.OtpHashActivity"
            android:exported="false"
            android:label="OTP Setup"
            android:theme="@style/Theme.MyApplication"/>

    </application>
</manifest>
