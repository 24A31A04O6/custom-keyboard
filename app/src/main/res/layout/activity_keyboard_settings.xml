<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_keyboard_settings.xml
    Gboard-style dark settings screen:
      • AppBar with back arrow and title "Settings"
      • Scrollable list of rows, each with: icon + title + optional subtitle
      • Section headers in blue (#8AB4F8) between groups
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1E22">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1E22"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A1E22"
            app:titleTextColor="#FFFFFF"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A1E22"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- ══ General ══════════════════════════════════════════════ -->

            <!-- Languages row -->
            <LinearLayout
                android:id="@+id/row_languages"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🌐"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Languages"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English (India) (QWERTY)"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Preferences row -->
            <LinearLayout
                android:id="@+id/row_preferences"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="≡"
                    android:textSize="24sp"
                    android:textColor="#9AA0A6"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Preferences"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

            <!-- Theme row -->
            <LinearLayout
                android:id="@+id/row_theme"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🎨"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Theme"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

            <!-- Corrections and suggestions row -->
            <LinearLayout
                android:id="@+id/row_corrections"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="A꜀"
                    android:textSize="18sp"
                    android:textColor="#9AA0A6"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Corrections and suggestions"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Glide typing row -->
            <LinearLayout
                android:id="@+id/row_glide"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="〜"
                    android:textSize="24sp"
                    android:textColor="#9AA0A6"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Glide typing"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swipe across letters to type"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Custom Background toggle row (MaterialSwitch) -->
            <LinearLayout
                android:id="@+id/row_custom_bg_toggle"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_palette"
                    android:tint="#9AA0A6"
                    android:scaleType="fitCenter"
                    android:contentDescription="Custom background"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom background"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use a photo as keyboard background"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_custom_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:trackTint="@color/switch_track_selector"
                    app:thumbTint="@color/switch_thumb_selector"/>

            </LinearLayout>

            <!-- Voice typing row -->
            <LinearLayout
                android:id="@+id/row_voice"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🎤"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voice typing"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

            <!-- Clipboard row -->
            <LinearLayout
                android:id="@+id/row_clipboard"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="📋"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clipboard"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

            <!-- Dictionary row -->
            <LinearLayout
                android:id="@+id/row_dictionary"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="📖"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dictionary"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telugu (1159 entries)"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Emojis, stickers and GIFs row -->
            <LinearLayout
                android:id="@+id/row_emoji"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="😊"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Emojis, stickers and GIFs"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

            <!-- Custom background row -->
            <LinearLayout
                android:id="@+id/row_custom_bg"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🖼"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom photo background"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_custom_bg_status"
                        android:text="Disabled"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Resize keyboard row -->
            <LinearLayout
                android:id="@+id/row_resize"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="⤢"
                    android:textSize="22sp"
                    android:textColor="#9AA0A6"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resize keyboard"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Long-press toolbar to resize"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Divider ───────────────────────────────────────────── -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2D3136" android:layout_marginVertical="8dp"/>

            <!-- Privacy row -->
            <LinearLayout
                android:id="@+id/row_privacy"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="🛡"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Privacy"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

            <!-- Rate us row -->
            <LinearLayout
                android:id="@+id/row_rate"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="⭐"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rate us"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

            <!-- About row -->
            <LinearLayout
                android:id="@+id/row_about"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="ℹ"
                    android:textSize="22sp"
                    android:textColor="#9AA0A6"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About"
                        android:textColor="#E8EAED"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BabelKey v1.0"
                        android:textColor="#9AA0A6"
                        android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Help and feedback row -->
            <LinearLayout
                android:id="@+id/row_help"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="❓"
                    android:textSize="22sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Help and feedback"
                    android:textColor="#E8EAED"
                    android:textSize="16sp"
                    android:paddingStart="20dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
